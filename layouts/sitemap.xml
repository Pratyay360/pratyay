<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <ctx :loop="$site.pages()">
    <ctx :if="$loop.it.link().eql('/search/').not()">
      <url>
        <loc :text="$site.host_url.addPath($loop.it.link())"></loc>
      </url>
    </ctx>
  </ctx>
</urlset>
