  "dev": "vite",
  "build": "tsc && vite build",
  "typecheck": "tsc --noEmit",
  "preview": "vite preview",
  "tauri": "tauri",
  "tauri:build": "tauri build && source src-tauri/scripts/patch-appimage-wayland.sh"
 },
